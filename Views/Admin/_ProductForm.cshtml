@model GolfBallProduct
<div asp-validation-summary="ModelOnly" class="validation-summary"></div>
<div class="form-grid">
    <div>
        <label asp-for="Brand"></label>
        <input asp-for="Brand" list="popular-brands" placeholder="Ej. Titleist" />
        <datalist id="popular-brands">
            <option>Titleist</option><option>Callaway</option><option>TaylorMade</option><option>Srixon</option><option>Bridgestone</option><option>Wilson</option>
        </datalist>
        <span asp-validation-for="Brand"></span>
    </div>
    <div>
        <label asp-for="Grade"></label>
        <select asp-for="Grade" asp-items="Html.GetEnumSelectList<GolfBallGrade>()"></select>
        <span asp-validation-for="Grade"></span>
    </div>
    <div>
        <label asp-for="PackSize"></label>
        <input asp-for="PackSize" type="number" min="1" />
        <span asp-validation-for="PackSize"></span>
    </div>
    <div>
        <label asp-for="Price"></label>
        <input asp-for="Price" type="number" min="0.01" step="0.01" />
        <span asp-validation-for="Price"></span>
    </div>
    <div>
        <label asp-for="StockPacks"></label>
        <input asp-for="StockPacks" type="number" min="0" />
        <span asp-validation-for="StockPacks"></span>
    </div>
    <label class="checkbox-label"><input asp-for="IsActive" /> @Html.DisplayNameFor(model => model.IsActive)</label>
</div>
